<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Prueba - Galería</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Nunito:wght@400;600;700;900&display=swap" rel="stylesheet">
<style>
  body { font-family: 'Nunito', sans-serif; background: #0f0f0f; min-height: 100vh; }
  .header { text-align: center; padding: 30px 20px 16px; }
  .header h1 { font-family:'Bebas Neue',sans-serif; font-size:2rem; color:#fff; }
  .header p { color:#666; font-size:.8rem; margin-top:4px; }

  .img-gallery { 
    width:100%; display:grid; grid-template-columns:1fr 1fr; 
    gap:10px; padding:10px; max-width:600px; margin:0 auto; 
  }
  .img-gallery img { 
    width:100%; border-radius:12px; box-shadow:0 4px 20px rgba(0,0,0,.5); 
    cursor:pointer; 
  }

  /* Modal mediano */
  .modal-backdrop { display:none; position:fixed; inset:0; background:rgba(0,0,0,.8); z-index:100; align-items:center; justify-content:center; }
  .modal-backdrop.open { display:flex; }
  .modal-content img { max-width:80%; max-height:80%; border-radius:12px; box-shadow:0 4px 20px rgba(0,0,0,.7); }
  .modal-close { position:absolute; top:20px; right:20px; background:#fff; border:none; border-radius:50%; width:40px; height:40px; cursor:pointer; }

  /* Fullscreen */
  .img-fullscreen { display:none; position:fixed; inset:0; background:rgba(0,0,0,.95); z-index:200; align-items:center; justify-content:center; }
  .img-fullscreen.open { display:flex; }
  .img-fullscreen img { max-width:100%; max-height:100%; object-fit:contain; }
  .img-fullscreen-close { position:absolute; top:16px; right:16px; background:rgba(255,255,255,.15); border:none; color:#fff; font-size:1.5rem; width:44px; height:44px; border-radius:50%; cursor:pointer; }
</style>
</head>
<body>

<div class="header">
  <h1>Prueba Galería</h1>
  <p>Miniaturas → Mediano → Fullscreen</p>
</div>

<div class="img-gallery" id="galeria"></div>

<!-- Modal mediano -->
<div class="modal-backdrop" id="modal">
  <button class="modal-close" onclick="closeModal()">✕</button>
  <div class="modal-content" id="modalContent"></div>
</div>

<!-- Fullscreen -->
<div class="img-fullscreen" id="fullscreen">
  <button class="img-fullscreen-close" onclick="closeFullscreen()">✕</button>
  <img id="fullscreenImg" src="" alt="">
</div>

<script>
// Array con los nombres de las imágenes en la carpeta "imagenes"
const imagenes = [
  "InCollage_20260526_110829041.jpg",
  "InCollage_20260527_105419730.jpg",
  "InCollage_20260602_124054940.jpg",
  "InCollage_20260603_140848246.jpg"
];

const galeria = document.getElementById("galeria");

// Crear miniaturas
imagenes.forEach(nombre => {
  const img = document.createElement("img");
  img.src = "imagenes/" + nombre;
  img.alt = nombre;
  img.onclick = () => openModal(nombre);
  galeria.appendChild(img);
});

// Abrir modal mediano
function openModal(nombre) {
  const modalContent = document.getElementById("modalContent");
  modalContent.innerHTML = `<img src="imagenes/${nombre}" alt="${nombre}" onclick="openFullscreen('${nombre}')">`;
  document.getElementById("modal").classList.add("open");
}

// Cerrar modal
function closeModal() {
  document.getElementById("modal").classList.remove("open");
  document.getElementById("modalContent").innerHTML = '';
}

// Abrir fullscreen
function openFullscreen(nombre) {
  document.getElementById("fullscreenImg").src = "imagenes/" + nombre;
  document.getElementById("fullscreen").classList.add("open");
}

// Cerrar fullscreen
function closeFullscreen() {
  document.getElementById("fullscreen").classList.remove("open");
  document.getElementById("fullscreenImg").src = '';
}
</script>

</body>
</html>
